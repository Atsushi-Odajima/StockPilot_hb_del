# StockPilot 環境変数の例（本物の値をこのファイルに書かないこと）
NODE_ENV=production
PORT=8080
# PostgreSQL 接続文字列（アプリ用の権限を絞ったロールを推奨）
DATABASE_URL=postgres://stockpilot_app:CHANGE_ME@db.example.internal:5432/stockpilot
# アップロード画像・バックアップ一時領域の保存先（非公開ディレクトリ／永続ボリューム）
DATA_DIR=/var/lib/stockpilot
# 公開URL（Origin検査・Cookie Secure判定に使用）
PUBLIC_ORIGIN=https://stockpilot.example.com
# 新規登録時の利用権: pending（運営者の付与待ち）/ active
REGISTRATION_DEFAULT_ENTITLEMENT=pending
# 新規登録の受付: open / closed
REGISTRATION=open
# パスワード再設定メールの送信方式: console（開発用） / none
MAILER=none
